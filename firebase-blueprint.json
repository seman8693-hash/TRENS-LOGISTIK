{
  "entities": {
    "Shipment": {
      "description": "Shipping resi tracking data",
      "properties": {
        "resi": { "type": "string" },
        "nama": { "type": "string" },
        "rute": { "type": "string" },
        "status": { "type": "string" },
        "posisi": { "type": "string" },
        "layanan": { "type": "string" },
        "estimasi": { "type": "string" },
        "berat": { "type": "string" },
        "koli": { "type": "number" },
        "moda": { "type": "string" },
        "pengirim": { "type": "string" },
        "penerima": { "type": "string" },
        "tanggal": { "type": "string" },
        "biaya": { "type": "number" },
        "history": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["resi", "nama", "status"]
    },
    "OrderRequest": {
      "description": "Customer order & pickup requests",
      "properties": {
        "id": { "type": "string" },
        "namaPengirim": { "type": "string" },
        "teleponPengirim": { "type": "string" },
        "kotaAsal": { "type": "string" },
        "alamatPickup": { "type": "string" },
        "kotaTujuan": { "type": "string" },
        "namaPenerima": { "type": "string" },
        "teleponPenerima": { "type": "string" },
        "layanan": { "type": "string" },
        "moda": { "type": "string" },
        "estimasiBerat": { "type": "number" },
        "deskripsiBarang": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "namaPengirim", "teleponPengirim", "kotaAsal", "kotaTujuan"]
    },
    "PartnerLead": {
      "description": "Partnership registration leads",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "perusahaan": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "kota": { "type": "string" },
        "kategori": { "type": "string" },
        "catatan": { "type": "string" },
        "status": { "type": "string" },
        "tanggal": { "type": "string" }
      },
      "required": ["id", "nama", "whatsapp", "kota", "kategori"]
    },
    "ActivityLog": {
      "description": "Operational and security activity log records",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "category": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetId": { "type": "string" },
        "level": { "type": "string" }
      },
      "required": ["id", "timestamp", "category", "action", "title", "level"]
    },
    "Invoice": {
      "description": "Commercial freight invoices and delivery orders",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "resi": { "type": "string" },
        "amount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAddress": { "type": "string" },
        "senderCity": { "type": "string" },
        "recipientAddress": { "type": "string" },
        "recipientCity": { "type": "string" },
        "itemDescription": { "type": "string" },
        "colly": { "type": "number" },
        "weight": { "type": "number" },
        "ongkirCargo": { "type": "number" },
        "biayaPacking": { "type": "number" },
        "asuransi": { "type": "number" },
        "ppnPercent": { "type": "number" },
        "deliveryOrderNo": { "type": "string" }
      },
      "required": ["id", "customerName", "total", "status"]
    }
  },
  "firestore": {
    "/shipments/{resi}": {
      "schema": "Shipment",
      "description": "Public and operational shipment tracking"
    },
    "/orders/{orderId}": {
      "schema": "OrderRequest",
      "description": "Order and pickup requests"
    },
    "/partners/{partnerId}": {
      "schema": "PartnerLead",
      "description": "Partnership applicant leads"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit trail and activity log entries"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices and delivery order documents"
    }
  }
}
